# Wireguard Installation Path
WIREGUARDPATH="/etc/wireguard"

# wg0.conf server key paths and files
SERVER_KEY_PATH="/wg0confkeys/server"
SERVER_PRIVATE_KEY_FILE_NAME="/private.key"
SERVER_PUBLIC_KEY_FILE_NAME="/public.key"

# wg0.conf client key paths and files
CLIENT_KEY_PATH="/wg0confkeys/client"
CLIENT_PRIVATE_KEY_FILE_NAME="/private.key"
CLIENT_PUBLIC_KEY_FILE_NAME="/public.key"

# Where connection keys will live
CONN_KEY_PATH="/connectionkeys"

# sysctl.conf path
SYSCTLFILEPATH="/etc/sysctl.conf"

# Port WireGuard is using (UDP)
FORWARDED_PORT="ENTER HERE" 

# Your internet's public IP address
# You can use www.whatsmyip.org to determine this
PUBLIC_IP="ENTER HERE"    

# Your IPV4's first three numbers from the left
# Structure: X.X.X.0/24
# Example: IPV4 = 123.456.2.67, LAN_ALLOWED_IP = 123.456.0/24
LAN_ALLOWED_IP="ENTER HERE"
